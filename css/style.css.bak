/* =========================================================
   ISH EDITION — portfolio styles
   Theme: RED + BLACK. Change the colors in :root below.
   ========================================================= */
:root{
  --red:#ff1f1f;
  --red-d:#b80000;
  --red-glow:rgba(255,31,31,.38);
  --bg:#070707;
  --bg-2:#0d0d0d;
  --card:#111;
  --line:#262626;
  --text:#f4f4f4;
  --muted:#9b9b9b;
  --display:"Bebas Neue",Impact,"Arial Narrow",sans-serif;
  --body:"Space Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  --maxw:1200px;
  --pad:clamp(16px,4vw,40px);
  --ease:cubic-bezier(.2,.8,.2,1);
}
@view-transition{navigation:auto}
::view-transition-old(root){animation:sceneExit .16s ease both}
::view-transition-new(root){animation:sceneEnter .26s var(--ease) both}
@keyframes sceneExit{to{opacity:.35;filter:brightness(.72);transform:translateY(-3px)}}
@keyframes sceneEnter{from{opacity:.55;filter:brightness(1.2);transform:translateY(7px)}to{opacity:1;filter:none;transform:none}}

/* ---------- base ---------- */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
html.nav-open,html.modal-open{overflow:hidden}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:var(--body);line-height:1.65;font-size:1rem;
  overflow-x:hidden;animation:pagein .6s var(--ease) both;
}
@keyframes pagein{from{opacity:0}to{opacity:1}}
img,video,svg,iframe{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
h1,h2,h3,p{margin:0}
::selection{background:var(--red);color:#fff}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:#2a2a2a;border:2px solid var(--bg)}
::-webkit-scrollbar-thumb:hover{background:var(--red)}
.skip{position:fixed;left:12px;top:-60px;z-index:400;background:var(--red);color:#000;padding:10px 16px;font-family:var(--mono);font-size:.8rem;transition:top .2s}
.skip:focus{top:12px}

/* film grain + scanlines overlays */
body::before{
  content:"";position:fixed;z-index:98;pointer-events:none;
  width:200%;height:200%;left:-50%;top:-50%;opacity:.07;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  animation:grain 1s steps(6) infinite;
}
@keyframes grain{
  0%{transform:translate(0,0)}20%{transform:translate(-4%,3%)}40%{transform:translate(3%,-5%)}
  60%{transform:translate(-3%,-2%)}80%{transform:translate(5%,4%)}100%{transform:translate(0,0)}
}
body::after{
  content:"";position:fixed;inset:0;z-index:97;pointer-events:none;opacity:.35;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.22) 0 1px,transparent 1px 3px);
}

/* ---------- shared editing-interface atmosphere ---------- */
main,.site-footer{position:relative;z-index:1}
.ambient-interface{
  --ambient-red:rgba(255,31,31,.58);
  position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;
  opacity:.62;color:#aaa;
}
.ambient-grid{
  position:absolute;inset:0;width:100%;height:100%;pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(circle at 50% 45%,rgba(0,0,0,.96),rgba(0,0,0,.45) 80%,transparent 100%);
  mask-image:radial-gradient(circle at 50% 45%,rgba(0,0,0,.96),rgba(0,0,0,.45) 80%,transparent 100%);
}
.ambient-interface.is-idle .ambient-graph path,.ambient-interface.is-idle .ambient-graph circle,
.ambient-interface.is-idle .ambient-key,.ambient-interface.is-idle .ambient-wave,
.ambient-interface.is-idle .ambient-path,.ambient-interface.is-idle .ambient-speed-ramp,
.ambient-interface.is-idle .path-node,.ambient-interface.is-idle .audio-bar,
.ambient-interface.is-idle .edit-term,.ambient-interface.is-idle .interface-tick{animation-play-state:paused}

/* Full Viewport Motion & Speed Curves */
.ambient-motion-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;opacity:.68}
.ambient-path{fill:none;stroke:rgba(255,31,31,.65);stroke-width:1.3;stroke-dasharray:5 12;animation:ambientPathTravel 22s linear infinite}
.ambient-path.ambient-path-secondary{stroke:rgba(235,235,235,.35);stroke-width:1.1;stroke-dasharray:3 14;animation-duration:32s;animation-direction:reverse}
.ambient-path.ambient-path-tertiary{stroke:rgba(255,60,60,.38);stroke-width:.9;stroke-dasharray:2 18;animation-duration:38s}
.ambient-speed-ramp{fill:none;stroke:rgba(255,31,31,.5);stroke-width:1.4;stroke-dasharray:8 12;animation:ambientSpeedRamp 26s linear infinite}
.ambient-tangent{stroke:rgba(255,255,255,.24);stroke-width:1;stroke-dasharray:2 4}
.path-node{fill:var(--red);filter:drop-shadow(0 0 7px var(--red));animation:ambientNodePulse 3.5s ease-in-out infinite alternate}
.path-node.path-node-secondary{fill:#eee;filter:drop-shadow(0 0 5px rgba(255,255,255,.6));animation-duration:4.8s}
@keyframes ambientPathTravel{to{stroke-dashoffset:-260}}
@keyframes ambientSpeedRamp{to{stroke-dashoffset:260}}
@keyframes ambientNodePulse{from{opacity:.4;transform:scale(.75);transform-origin:center}to{opacity:1;transform:scale(1.25);transform-origin:center}}

/* Fine Graph Overlay */
.ambient-graph{position:absolute;inset:0;width:100%;height:100%;opacity:.48}
.ambient-graph path{fill:none;stroke:rgba(255,31,31,.4);stroke-width:1.1;stroke-dasharray:4 12;animation:ambientGraphMove 28s linear infinite}
.ambient-graph .ambient-curve-alt{stroke:rgba(220,220,220,.22);stroke-dasharray:2 16;animation-duration:36s;animation-direction:reverse}
.ambient-graph circle{fill:rgba(255,31,31,.75);filter:drop-shadow(0 0 6px rgba(255,31,31,.45));animation:ambientNode 4.5s ease-in-out infinite alternate}
.ambient-graph circle:nth-of-type(2){animation-delay:1.6s}
.ambient-graph circle:nth-of-type(3){animation-delay:2.8s}
@keyframes ambientGraphMove{to{stroke-dashoffset:-240}}
@keyframes ambientNode{to{opacity:.25;transform:scale(.7);transform-origin:center}}

/* Tracking Crosshairs */
.ambient-cross{position:absolute;width:18px;height:18px;opacity:.38;color:rgba(255,255,255,.55)}
.ambient-cross::before,.ambient-cross::after{content:"";position:absolute;background:currentColor}
.ambient-cross::before{left:0;right:0;top:50%;height:1px}
.ambient-cross::after{top:0;bottom:0;left:50%;width:1px}
.ambient-cross-a{top:12%;left:7%}
.ambient-cross-b{right:10%;top:18%;transform:scale(.85)}
.ambient-cross-c{bottom:26%;left:12%;transform:scale(.75)}
.ambient-cross-d{right:26%;bottom:16%;transform:scale(.9)}
.ambient-cross-e{top:58%;left:48%;transform:scale(.7);opacity:.25}

/* VFX Motion Tracking Markers */
.ambient-tracker{position:absolute;display:flex;align-items:center;gap:6px;font:600 .54rem/1 var(--mono);letter-spacing:.14em;color:rgba(255,80,80,.62);pointer-events:none}
.tracker-tl{top:15%;left:18%}
.tracker-br{bottom:24%;right:16%}
.track-box{display:inline-block;width:12px;height:12px;border:1px solid rgba(255,31,31,.6);position:relative}
.track-box::before{content:"";position:absolute;inset:2px;background:rgba(255,31,31,.25);animation:trackBlink 2.2s infinite ease-in-out}
@keyframes trackBlink{0%,100%{opacity:.2}50%{opacity:.8}}

/* Floating Keyframe Diamonds */
.ambient-key{position:absolute;width:8px;height:8px;border:1px solid var(--ambient-red);transform:rotate(45deg);box-shadow:0 0 10px rgba(255,31,31,.45);opacity:.48;animation:ambientKey 6s ease-in-out infinite}
.ambient-key-a{top:20%;right:8%}
.ambient-key-b{bottom:30%;left:18%;animation-delay:-3s}
.ambient-key-c{top:44%;left:5%;width:6px;height:6px;animation-delay:-1.5s}
.ambient-key-d{bottom:20%;right:34%;width:7px;height:7px;animation-delay:-4.2s}
.ambient-key-e{top:72%;left:32%;width:6px;height:6px;animation-delay:-2.4s}
@keyframes ambientKey{50%{translate:0 -9px;opacity:.8}}

/* Cut Markers & Sweeping Ticks */
.interface-tick{position:absolute;width:clamp(40px,7vw,92px);height:1px;background:linear-gradient(90deg,transparent,rgba(255,31,31,.65),transparent);opacity:.55;transform:rotate(-25deg);animation:tickSweep 8s ease-in-out infinite}
.tick-a{left:5%;top:34%}
.tick-b{right:7%;bottom:30%;transform:rotate(25deg);animation-delay:-4s}
.tick-c{left:44%;top:78%;transform:rotate(-15deg);animation-delay:-2.5s;width:clamp(30px,5vw,70px)}
@keyframes tickSweep{0%,100%{opacity:.15;transform:scale(.75) rotate(-25deg)}50%{opacity:.75;transform:scale(1) rotate(-25deg)}}
.tick-b{animation-name:tickSweepB}
@keyframes tickSweepB{0%,100%{opacity:.15;transform:scale(.75) rotate(25deg)}50%{opacity:.75;transform:scale(1) rotate(25deg)}}
.cut-marker{position:absolute;font:600 .5rem/1 var(--mono);letter-spacing:.16em;color:rgba(255,255,255,.32);border-left:1px solid var(--red);padding-left:5px}
.cut-marker-a{top:28%;left:3%}
.cut-marker-b{bottom:38%;right:3%}

/* Audio Frequency Spectrum Visualizer */
.ambient-audio-strip{position:absolute;left:18px;top:42%;display:flex;align-items:flex-end;gap:3px;height:40px;opacity:.35;pointer-events:none}
.audio-bar{width:2px;height:var(--h,50%);background:linear-gradient(180deg,rgba(255,31,31,.85),rgba(255,31,31,.25));animation:audioBounce 1.2s ease-in-out infinite alternate;animation-delay:var(--d,0s)}
@keyframes audioBounce{to{height:calc(var(--h,50%) * 0.35 + 15%)}}

/* Audio Waveform */
.ambient-wave{position:absolute;right:0;top:22%;width:min(28vw,340px);height:36px;opacity:.28;
  background:repeating-linear-gradient(90deg,transparent 0 5px,rgba(255,31,31,.85) 5px 6px,transparent 6px 10px);
  clip-path:polygon(0 48%,3% 35%,6% 65%,9% 15%,12% 78%,15% 40%,18% 55%,21% 5%,24% 85%,27% 35%,30% 65%,33% 20%,36% 55%,39% 40%,42% 72%,45% 12%,48% 60%,51% 35%,54% 76%,57% 18%,60% 48%,63% 28%,66% 82%,69% 25%,72% 57%,75% 8%,78% 68%,81% 38%,84% 78%,87% 24%,90% 60%,93% 32%,96% 68%,100% 45%,100% 55%,96% 78%,93% 42%,90% 72%,87% 35%,84% 90%,81% 48%,78% 82%,75% 20%,72% 68%,69% 35%,66% 92%,63% 38%,60% 58%,57% 30%,54% 88%,51% 45%,48% 72%,45% 24%,42% 82%,39% 50%,36% 65%,33% 32%,30% 78%,27% 48%,24% 92%,21% 14%,18% 64%,15% 48%,12% 88%,9% 25%,6% 75%,3% 45%,0 55%);
  animation:waveDrift 18s linear infinite alternate;
}
@keyframes waveDrift{to{translate:-22px 0;opacity:.42}}

/* Drifting Editing Terminology */
.edit-term{
  position:absolute;display:block;white-space:nowrap;pointer-events:none;
  font-family:var(--mono);font-size:clamp(.65rem,.8vw,.82rem);font-weight:600;letter-spacing:.2em;
  color:rgba(220,220,220,.5);opacity:0;text-shadow:0 0 12px rgba(255,255,255,.12);
  animation:termDrift 12s ease-in-out infinite;
}
.term-cut{top:11%;left:4%;color:rgba(255,60,60,.68);font-size:clamp(.8rem,1.15vw,1.05rem);animation-delay:-1s;animation-duration:10s}
.term-render{top:14%;left:40%;color:rgba(235,235,235,.55);animation-delay:-6.5s;animation-duration:13.5s}
.term-keyframes{top:13%;right:7%;color:rgba(255,60,60,.58);animation-delay:-3.5s;animation-duration:12s}
.term-timeline{top:48%;left:3%;font-size:clamp(.62rem,.74vw,.74rem);animation-delay:-4s;animation-duration:11.5s}
.term-transition{top:52%;right:4%;color:rgba(255,60,60,.6);animation-delay:-8s;animation-duration:13s}
.term-grade{bottom:18%;left:22%;color:rgba(230,230,230,.58);animation-delay:-5.5s;animation-duration:14s}
@keyframes termDrift{
  0%,8%{opacity:0;translate:0 8px;filter:blur(1px)}
  18%,55%{opacity:.55;translate:0 0;filter:blur(0)}
  65%,100%{opacity:0;translate:0 -7px;filter:blur(1px)}
}

/* Subtle Technical HUD Metadata */
.ambient-tech-strip{position:absolute;display:flex;align-items:center;gap:8px;font:500 .5rem/1 var(--mono);letter-spacing:.16em;color:rgba(255,255,255,.32);pointer-events:none}
.ambient-tech-top{top:20px;left:var(--pad)}
.ambient-tech-top i{color:var(--red);font-style:normal;opacity:.8}
.ambient-apps{position:absolute;right:var(--pad);bottom:20px;display:flex;align-items:center;gap:6px;opacity:.35}
.app-badge{display:inline-grid;place-items:center;width:24px;height:24px;border:1px solid rgba(255,255,255,.34);border-radius:5px;font:700 .7rem/1 var(--mono);letter-spacing:-.08em;background:rgba(9,9,9,.82);box-shadow:0 4px 12px rgba(0,0,0,.25)}
.app-pr{color:#f18a31;border-color:rgba(241,138,49,.55)}
.app-ae{color:#a990ff;border-color:rgba(169,144,255,.55)}
.ambient-app-label{margin-left:4px;font:600 .52rem/1 var(--mono);letter-spacing:.14em;color:rgba(220,220,220,.72)}
.ambient-coordinate{position:absolute;left:var(--pad);bottom:20px;font:500 .52rem/1 var(--mono);letter-spacing:.12em;color:rgba(220,220,220,.45)}

/* ---------- layout helpers ---------- */
.wrap{width:min(var(--maxw),calc(100% - 2 * var(--pad)));margin-inline:auto}
.section{padding:clamp(70px,10vw,130px) 0}
.section.tight{padding-top:20px}
.red{color:var(--red)}
.h-display{
  font-family:var(--display);font-weight:400;font-synthesis:none;
  text-transform:uppercase;line-height:.92;letter-spacing:.012em;
}
.h2{font-size:clamp(2.6rem,7vw,5.2rem)}
.eyebrow{
  display:flex;align-items:center;gap:14px;margin-bottom:18px;
  font-family:var(--mono);font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:var(--red);
}
.eyebrow::before{content:"";width:34px;height:2px;background:var(--red)}
.lede{max-width:60ch;color:#cfcfcf;font-size:clamp(1.02rem,1.5vw,1.2rem)}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:44px}
.link-arrow{font-family:var(--mono);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:4px;transition:color .25s,border-color .25s}
.link-arrow:hover{color:var(--red);border-color:var(--red)}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.7em;
  padding:1em 1.8em;border:1px solid var(--red);
  font-family:var(--mono);font-size:.78rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  transition:transform .3s var(--ease),box-shadow .3s,background .3s,color .3s;
}
.btn .arr{display:inline-block;transition:transform .3s var(--ease)}
.btn:hover .arr{transform:translateX(5px)}
.btn-primary{background:var(--red);color:#fff}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 14px 40px -12px var(--red-glow),0 0 0 1px var(--red)}
.btn-ghost{color:var(--text)}
.btn-ghost:hover{background:rgba(255,31,31,.14);transform:translateY(-3px)}
.btn-dark{background:#000;border-color:#000;color:#fff}
.btn-dark:hover{transform:translateY(-3px);background:#111}
.btn[disabled]{opacity:.6;pointer-events:none}

/* ---------- header / nav ---------- */
.progress{position:fixed;left:0;top:0;height:3px;width:100%;background:var(--red);z-index:120;transform:scaleX(0);transform-origin:left;box-shadow:0 0 12px var(--red)}
.site-header{
  position:fixed;left:0;right:0;top:0;z-index:100;height:68px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 var(--pad);border-bottom:1px solid transparent;transition:border-color .3s;
}
.site-header::before{
  content:"";position:absolute;inset:0;z-index:-1;opacity:0;transition:opacity .3s;
  background:rgba(7,7,7,.82);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
}
.site-header.scrolled{border-color:var(--line)}
.site-header.scrolled::before{opacity:1}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--display);font-size:1.7rem;letter-spacing:.07em;line-height:1;position:relative;z-index:3}
.rec-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--red);box-shadow:0 0 12px var(--red);animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.nav{display:flex;gap:clamp(14px,2.2vw,34px)}
.nav a{
  position:relative;padding:8px 0;color:var(--muted);transition:color .25s,transform .25s var(--ease),text-shadow .25s;
  font-family:var(--mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;
}
.nav a span{color:var(--red);margin-right:6px;opacity:.85}
.nav a::after{
  content:"";position:absolute;left:0;bottom:2px;height:2px;width:100%;background:var(--red);
  transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease);
}
.nav a:hover,.nav a.active{color:#fff}
.nav a:hover{transform:translateY(-1px);text-shadow:0 0 12px rgba(255,31,31,.18)}
.nav a:hover::after,.nav a.active::after{transform:scaleX(1)}
.burger{display:none;position:relative;z-index:3;width:44px;height:44px;align-items:center;justify-content:center}
.burger i{position:absolute;left:11px;width:22px;height:2px;background:#fff;transition:transform .3s var(--ease),opacity .2s,top .3s var(--ease)}
.burger i:nth-child(1){top:15px}
.burger i:nth-child(2){top:21px}
.burger i:nth-child(3){top:27px}
html.nav-open .burger i:nth-child(1){top:21px;transform:rotate(45deg)}
html.nav-open .burger i:nth-child(2){opacity:0}
html.nav-open .burger i:nth-child(3){top:21px;transform:rotate(-45deg)}

/* ---------- hero ---------- */
.hero{
  position:relative;isolation:isolate;overflow:hidden;
  min-height:100vh;min-height:100svh;
  display:flex;flex-direction:column;justify-content:center;
  padding:clamp(92px,12vh,120px) 0 clamp(32px,5vh,48px);
}
.hero::before{
  content:"";position:absolute;inset:0;z-index:-2;pointer-events:none;
  background:
    radial-gradient(55% 65% at 75% 38%,rgba(255,31,31,.12),transparent 72%),
    radial-gradient(40% 50% at 10% 75%,rgba(184,0,0,.1),transparent 75%),
    linear-gradient(115deg,rgba(7,7,7,.4) 15%,rgba(10,8,8,.3) 55%,rgba(7,7,7,.4) 100%);
}
.hero::after{
  content:"";position:absolute;z-index:-1;pointer-events:none;width:42vw;height:42vw;right:2%;top:8%;
  border-radius:50%;background:radial-gradient(circle,rgba(255,31,31,.11),rgba(255,31,31,.02) 48%,transparent 72%);
  animation:heroGlow 12s ease-in-out infinite alternate;
}
@keyframes heroGlow{
  from{transform:translate3d(0,0,0) scale(.88);opacity:.4}
  to{transform:translate3d(-6%,6%,0) scale(1.06);opacity:.75}
}
.hero-wrap{display:flex;flex-direction:column;gap:clamp(30px,4.5vw,48px);position:relative;z-index:2}
.hero-main-layout{
  display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,0.75fr);gap:clamp(28px,4vw,56px);align-items:center;
}
.hero-left-col{
  display:flex;align-items:flex-start;gap:clamp(14px,2.2vw,24px);min-width:0;
}
.hero-toolbar{
  position:relative;z-index:5;flex-shrink:0;
  display:flex;flex-direction:column;align-items:center;gap:4px;
  padding:7px 5px;border:1px solid rgba(255,255,255,.09);border-radius:8px;
  background:linear-gradient(180deg,rgba(22,22,24,.92),rgba(10,10,12,.86));
  box-shadow:0 14px 34px rgba(0,0,0,.35),inset 0 1px rgba(255,255,255,.04);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  margin-top:4px;
}
.toolbar-apps{display:flex;flex-direction:column;gap:4px;align-items:center}
.toolbar-app{width:25px;height:25px;font-size:.68rem}
.toolbar-divider{width:16px;height:1px;margin:3px 0;background:rgba(255,255,255,.14)}
.toolbar-tools{display:flex;flex-direction:column;gap:3px;align-items:center}
.tool-button{
  position:relative;display:grid;place-items:center;width:29px;height:29px;border:1px solid transparent;border-radius:5px;
  color:#929292;transition:color .18s,background .18s,border-color .18s,transform .2s var(--ease);
}
.tool-button svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}
.tool-button:hover,.tool-button:focus-visible{color:#fff;background:rgba(255,31,31,.11);border-color:rgba(255,31,31,.32);transform:scale(1.05)}
.tool-button.selected{color:#fff;background:rgba(255,31,31,.18);border-color:rgba(255,31,31,.45);box-shadow:inset 0 0 6px rgba(255,31,31,.25)}
.tool-button::after{
  content:attr(title);position:absolute;left:calc(100% + 10px);top:50%;z-index:12;pointer-events:none;
  padding:5px 8px;border:1px solid var(--line);border-radius:4px;background:#111;color:#ddd;
  font:500 .58rem/1.2 var(--mono);letter-spacing:.04em;white-space:nowrap;opacity:0;transform:translateY(-50%) translateX(-4px);
  transition:opacity .16s,transform .16s;box-shadow:0 8px 18px rgba(0,0,0,.4);
}
.tool-button:hover::after,.tool-button:focus-visible::after{opacity:1;transform:translateY(-50%) translateX(0)}

.hero-copy{flex:1;min-width:0;position:relative}
.rec{display:inline-flex;align-items:center;gap:12px;margin-bottom:18px;font-family:var(--mono);font-size:.78rem;letter-spacing:.2em;color:var(--red)}
.rec em{font-style:normal;color:var(--muted)}
.hero-title{display:flex;align-items:baseline;gap:clamp(.12em,.2em,.26em);width:100%;margin:0 0 14px;position:relative;z-index:1;white-space:nowrap;font-family:var(--display);font-size:clamp(2.4rem,8.5vw,7.8rem);font-weight:400;font-synthesis:none;line-height:.92;text-transform:uppercase;letter-spacing:.015em}
.hero-title .glitch{display:inline-block;flex:0 0 auto;font-size:1em;line-height:inherit;letter-spacing:inherit;transform:none}
.hero-title .outline{
  display:inline-block;flex:0 0 auto;width:auto;font-size:1em;letter-spacing:.035em;margin:0;text-align:left;line-height:inherit;
  color:transparent;-webkit-text-stroke:1.5px var(--red);transition:color .4s,text-shadow .4s;white-space:nowrap;transform:none;
}
.hero-title .outline:hover{color:var(--red);text-shadow:0 0 24px var(--red-glow)}

/* VIDEO EDITOR and VFX ARTIST unified stable typewriter */
.hero-role{
  display:flex;align-items:center;width:100%;max-width:100%;min-height:1.5em;margin:0 0 16px;overflow:visible;
  font-family:var(--display);font-size:clamp(1.35rem,2.4vw,2.15rem);font-weight:400;font-synthesis:none;
  letter-spacing:.18em;line-height:1.2;text-transform:uppercase;color:#f4f4f4;white-space:nowrap;
}
.role-type-slot{
  display:inline-flex;align-items:center;position:relative;
  /* Reserve consistent width so both VIDEO EDITOR and VFX ARTIST occupy the exact same position */
  width:clamp(230px,18vw,320px);min-width:clamp(230px,18vw,320px);flex-shrink:0;text-align:left;
}
#role-typewriter{
  display:inline;font-family:var(--display);font-size:inherit;font-weight:400;
  font-synthesis:none;letter-spacing:.18em;text-transform:uppercase;color:#f4f4f4;
}
.tw-cursor{
  display:inline-block;width:2.5px;height:.8em;margin-left:3px;vertical-align:middle;
  background:var(--red);box-shadow:0 0 8px var(--red);animation:twBlink .75s step-end infinite;
}
@keyframes twBlink{0%,100%{opacity:1}50%{opacity:0}}

.hero-lede{max-width:48ch;margin:0 0 22px;color:#cfcfcf;font-size:clamp(.96rem,1.3vw,1.08rem);line-height:1.55}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px}

/* Dedicated hero photo stage (prepared for user photo upload) */
.hero-photo-stage{
  position:relative;display:flex;align-items:center;justify-content:center;
  min-height:360px;width:100%;
}
.photo-ambient-glow{
  position:absolute;width:min(320px,80%);aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,rgba(255,31,31,.22),rgba(255,31,31,.04) 55%,transparent 72%);
  filter:blur(32px);pointer-events:none;
}
.photo-frame-target{
  position:relative;width:100%;max-width:380px;display:flex;justify-content:center;align-items:flex-end;
}
#hero-photo-container{width:100%;max-width:380px}
.portrait-frame{
  position:relative;width:100%;aspect-ratio:3/4;overflow:hidden;
  border:1px solid rgba(255,31,31,.22);
  background:linear-gradient(160deg,#0a0608 0%,#0d0608 40%,#120508 100%);
}
.portrait-frame svg{position:absolute;inset:0;width:100%;height:100%}
.portrait-corner{position:absolute;width:20px;height:20px;border:1.5px solid var(--red);z-index:4;opacity:.8}
.portrait-corner.pc-tl{left:12px;top:12px;border-right:0;border-bottom:0}
.portrait-corner.pc-tr{right:12px;top:12px;border-left:0;border-bottom:0}
.portrait-corner.pc-bl{left:12px;bottom:12px;border-right:0;border-top:0}
.portrait-corner.pc-br{right:12px;bottom:12px;border-left:0;border-top:0}
.portrait-cam{
  position:absolute;top:18px;left:38px;z-index:4;
  display:flex;align-items:center;gap:6px;
  font:600 .58rem/1 var(--mono);letter-spacing:.2em;color:rgba(255,255,255,.75);
  text-shadow:0 1px 6px rgba(0,0,0,.8);
}
.portrait-cam-dot{width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red);animation:blink 1.4s ease-in-out infinite}
.portrait-vignette{
  position:absolute;inset:0;z-index:3;pointer-events:none;
  background:
    radial-gradient(ellipse 85% 100% at 50% 100%,rgba(0,0,0,.0),rgba(0,0,0,.72) 90%),
    radial-gradient(ellipse 100% 60% at 50% 0%,rgba(0,0,0,.55),transparent 80%);
}
.portrait-rimlight{
  position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(100deg,transparent 55%,rgba(255,20,20,.13) 72%,rgba(255,20,20,.22) 80%,rgba(255,60,60,.08) 90%,transparent 100%);
  animation:rimPulse 5s ease-in-out infinite alternate;
}
@keyframes rimPulse{from{opacity:.5}to{opacity:1}}

/* glitch text */
.glitch{position:relative}
.glitch::before,.glitch::after{
  content:attr(data-text);position:absolute;left:0;top:0;width:100%;height:100%;
  overflow:hidden;clip-path:inset(0 0 100% 0);pointer-events:none;
}
.glitch::before{color:var(--red);animation:gl1 4.2s infinite steps(1)}
.glitch::after{color:#fff;animation:gl2 4.2s infinite steps(1)}
@keyframes gl1{
  0%,89%,100%{clip-path:inset(0 0 100% 0);transform:none}
  90%{clip-path:inset(18% 0 58% 0);transform:translate(-6px,2px)}
  93%{clip-path:inset(62% 0 14% 0);transform:translate(5px,-2px)}
  96%{clip-path:inset(38% 0 40% 0);transform:translate(-3px,0)}
}
@keyframes gl2{
  0%,90%,100%{clip-path:inset(0 0 100% 0);transform:none}
  91%{clip-path:inset(48% 0 30% 0);transform:translate(6px,0)}
  94%{clip-path:inset(8% 0 72% 0);transform:translate(-5px,1px)}
  97%{clip-path:inset(70% 0 8% 0);transform:translate(3px,-1px)}
}

/* refined editing timeline */
.timeline{position:relative;width:100%;pointer-events:none;z-index:2}
.tl-inner{
  position:relative;width:100%;padding:6px 10px 6px;
  border:1px solid rgba(255,255,255,.08);border-bottom-color:rgba(255,31,31,.24);border-radius:6px;
  background:linear-gradient(180deg,rgba(16,16,18,.9),rgba(9,9,11,.84));
  box-shadow:0 12px 28px rgba(0,0,0,.28);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
}
.tl-inner::before{
  content:"";position:absolute;left:29px;right:8px;top:22px;bottom:4px;pointer-events:none;
  background:repeating-linear-gradient(90deg,rgba(255,255,255,.025) 0 1px,transparent 1px 38px);
}
.tl-ruler{
  height:16px;display:flex;align-items:center;justify-content:space-between;
  padding:0 6px 0 28px;border-bottom:1px solid rgba(255,255,255,.1);
  background:repeating-linear-gradient(90deg,transparent 0 38px,rgba(180,180,180,.1) 38px 39px);
  font:500 .48rem/1 var(--mono);letter-spacing:.04em;color:#7e7e7e;
}
.tl-timecode-mark{flex:0 0 auto}
.tl-composition{
  position:absolute;right:9px;top:-19px;display:flex;align-items:center;gap:6px;
  color:#828282;font:500 .47rem/1 var(--mono);letter-spacing:.08em;
}
.tl-composition .app-badge{width:16px;height:16px;font-size:.54rem;border-radius:3px}
.tl-composition i{width:1px;height:10px;margin:0 2px;background:rgba(255,255,255,.16)}
.tl-lane{display:flex;align-items:center;gap:6px;height:18px;position:relative}
.tl-channel{flex:0 0 18px;font:600 .5rem/1 var(--mono);letter-spacing:.04em;color:#787878;text-align:center}
.tl-lane.tl-audio-lane .tl-channel{color:rgba(255,90,90,.72)}
.tl-track{display:flex;align-items:center;gap:3px;height:13px;margin:0;position:relative;flex:1;min-width:0}
.tl-lane .tl-video-track-two,.tl-lane .tl-audio-track,.tl-lane .tl-graphics-track{width:auto;margin-left:0}
.tl-track i{
  position:relative;display:block;flex:var(--g,1) 1 0;min-width:0;height:11px;overflow:hidden;
  background:linear-gradient(90deg,#18181e,#22222a);border:1px solid #32323e;border-radius:2px;
}
.tl-track i .tl-clip-name{
  position:absolute;inset:0;display:flex;align-items:center;padding:0 5px;
  color:rgba(255,255,255,.65);font:500 .41rem/1 var(--mono);font-style:normal;letter-spacing:.06em;
  white-space:nowrap;overflow:hidden;
}
.tl-track i.r{
  background:linear-gradient(90deg,rgba(150,16,16,.7),rgba(220,24,24,.75));
  border-color:rgba(255,31,31,.6);box-shadow:0 0 10px -5px var(--red-glow);
}
.tl-track.tl-video-track-two i{background:linear-gradient(90deg,#15191e,#1f252c);border-color:#303640}
.tl-track.tl-video-track-two i.r{background:linear-gradient(90deg,rgba(112,0,0,.7),rgba(200,20,20,.75));border-color:rgba(255,31,31,.55)}
.tl-track.tl-audio-track i{
  height:11px;
  background:repeating-linear-gradient(90deg,transparent 0 3px,rgba(178,178,178,.35) 3px 4px,transparent 4px 7px),linear-gradient(#1a1a1a,#141414);
  border-color:#343434;
}
.tl-track.tl-audio-track i.r{
  background:repeating-linear-gradient(90deg,transparent 0 4px,rgba(255,210,210,.45) 4px 5px,transparent 5px 8px),linear-gradient(rgba(140,0,0,.55),rgba(65,0,0,.7));
  border-color:rgba(255,31,31,.45);
}
.tl-track.tl-graphics-track i{height:9px;background:linear-gradient(90deg,#211f28,#2d2936);border-color:#3e3646}
.tl-track.tl-graphics-track i.r{background:linear-gradient(90deg,rgba(128,0,0,.6),rgba(255,31,31,.72));border-color:rgba(255,31,31,.55)}
.tl-kf{position:absolute;top:2px;width:5px;height:5px;border:1px solid #fff;transform:rotate(45deg);box-shadow:0 0 4px rgba(255,255,255,.5)}
.tl-kf:first-child{left:30%}
.tl-kf:last-child{right:25%}
.tl-audio-track .tl-kf{display:none}
.playhead{position:absolute;top:20px;bottom:4px;left:29px;width:1.5px;background:#fff;box-shadow:0 0 10px var(--red);animation:scrub 14s linear infinite}
.playhead::before{content:"";position:absolute;top:0;left:-5px;border:6px solid transparent;border-top:8px solid #fff;border-bottom:0}
@keyframes scrub{from{left:0}to{left:100%}}

/* marquee */
.marquee{overflow:hidden;border-block:1px solid var(--line);background:var(--bg-2);padding:20px 0}
.marquee-track{display:flex;width:max-content;animation:marq 34s linear infinite}
.marquee:hover .marquee-track{animation-play-state:paused}
.marquee-track span{
  display:flex;align-items:center;white-space:nowrap;padding-right:48px;
  font-family:var(--display);font-size:clamp(1.6rem,3vw,2.4rem);letter-spacing:.06em;text-transform:uppercase;color:#6c6c6c;
}
.marquee-track span::after{content:"/";margin-left:48px;color:var(--red);font-family:var(--mono);font-size:.65em}
@keyframes marq{to{transform:translateX(-50%)}}

/* ---------- panels ---------- */
.panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.panel{
  position:relative;overflow:hidden;padding:30px 26px 32px;background:var(--card);border:1px solid var(--line);
  transition:transform .4s var(--ease),border-color .3s,box-shadow .4s;
}
.panel::before{content:"";position:absolute;left:0;top:0;height:3px;width:100%;background:var(--red);transform:scaleX(0);transform-origin:left;transition:transform .5s var(--ease)}
.panel:hover{transform:translateY(-6px);border-color:#4a1212;box-shadow:0 22px 50px -26px var(--red-glow)}
.panel:hover::before{transform:scaleX(1)}
.panel .num{display:block;margin-bottom:16px;font-family:var(--display);font-size:3.4rem;line-height:1;color:transparent;-webkit-text-stroke:1.5px var(--red)}
.panel h3{font-family:var(--display);font-weight:400;font-size:1.9rem;letter-spacing:.04em;text-transform:uppercase;margin-bottom:8px}
.panel p{color:var(--muted);font-size:.96rem}
.home-services{grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:14px}
.home-services .home-service{min-height:228px;padding:24px 22px 30px;isolation:isolate}
.home-services .home-service .num{margin-bottom:20px;font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;color:var(--red);-webkit-text-stroke:0}
.home-services .home-service h3{max-width:17ch;font-size:clamp(1.45rem,2.3vw,1.85rem);line-height:1.03}
.home-services .home-service p{max-width:32ch}
.service-mark{position:absolute;z-index:-1;right:14px;bottom:-22px;color:rgba(255,31,31,.09);font-family:var(--display);font-size:5.8rem;line-height:1;letter-spacing:.03em;transition:color .35s,transform .45s var(--ease)}
.home-services .home-service:hover .service-mark{color:rgba(255,31,31,.18);transform:translate(-5px,-5px)}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.tags span{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border:1px solid var(--line);color:#c9c9c9}

/* CTA band */
.cta-band{background:var(--red);color:#000;padding:clamp(56px,8vw,100px) 0;position:relative;overflow:hidden}
.cta-band::after{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.14;
  background:repeating-linear-gradient(90deg,#000 0 2px,transparent 2px 60px);
}
.cta-band .wrap{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.cta-band h2{font-size:clamp(2.8rem,8vw,6.4rem)}

/* ---------- inner page hero ---------- */
.page-hero{padding:calc(68px + clamp(56px,9vw,120px)) 0 clamp(28px,5vw,56px);position:relative;isolation:isolate;overflow:hidden}
.page-hero::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(50% 80% at 90% 0%,rgba(255,31,31,.2),transparent 70%)}
.page-title{font-size:clamp(3.4rem,11vw,9rem);margin-bottom:22px}

/* ---------- about ---------- */
.about-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,5vw,72px);align-items:start}
.frame{position:relative;aspect-ratio:4/5;background:#0b0b0b;border:1px solid var(--line);overflow:hidden}
.frame::before{content:"ISH";position:absolute;inset:0;display:grid;place-items:center;font-family:var(--display);font-size:clamp(7rem,16vw,12rem);letter-spacing:.06em;color:#171717}
.frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.05) saturate(.9)}
.frame .corner{position:absolute;width:28px;height:28px;border:2px solid var(--red);z-index:2}
.frame .c1{left:14px;top:14px;border-right:0;border-bottom:0}
.frame .c2{right:14px;top:14px;border-left:0;border-bottom:0}
.frame .c3{left:14px;bottom:14px;border-right:0;border-top:0}
.frame .c4{right:14px;bottom:14px;border-left:0;border-top:0}
.frame .cam{position:absolute;z-index:2;left:52px;top:18px;display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:.7rem;letter-spacing:.18em;color:#fff;text-shadow:0 1px 6px #000}
.about-copy p{color:#cfcfcf;margin-bottom:18px;max-width:62ch}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:30px 0 0}
.fact{padding:16px 18px;border:1px solid var(--line);background:var(--card)}
.fact small{display:block;font-family:var(--mono);font-size:.66rem;letter-spacing:.18em;text-transform:uppercase;color:var(--red);margin-bottom:4px}
.fact b{font-weight:500}
.xp{margin-top:20px}
.xp-item{position:relative;padding:0 0 38px 30px;border-left:2px solid var(--line)}
.xp-item:last-child{padding-bottom:0}
.xp-item::before{content:"";position:absolute;left:-7px;top:6px;width:12px;height:12px;background:var(--red);box-shadow:0 0 0 4px var(--bg),0 0 14px var(--red-glow)}
.xp-year{font-family:var(--mono);font-size:.74rem;letter-spacing:.18em;color:var(--red);text-transform:uppercase}
.xp-item h3{font-family:var(--display);font-weight:400;font-size:1.8rem;letter-spacing:.04em;text-transform:uppercase;margin:2px 0 4px}
.xp-item p{color:var(--muted);max-width:56ch}

/* ---------- skills ---------- */
.tool-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.tool{display:flex;align-items:center;gap:16px;padding:16px;background:var(--card);border:1px solid var(--line);transition:transform .35s var(--ease),border-color .3s}
.tool:hover{transform:translateY(-4px);border-color:var(--red)}
.tool .ico{flex:0 0 52px;height:52px;display:grid;place-items:center;border:2px solid var(--red);border-radius:10px;color:var(--red);font-family:var(--display);font-size:1.6rem;letter-spacing:.04em;transition:background .3s,color .3s}
.tool:hover .ico{background:var(--red);color:#000}
.tool b{display:block;font-weight:600;line-height:1.2}
.tool small{color:var(--muted)}
.style-list{border-bottom:1px solid var(--line)}
.style-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:22px;align-items:center;padding:26px 0;border-top:1px solid var(--line);transition:padding .35s var(--ease),background .3s}
.style-row h3{font-family:var(--display);font-weight:400;font-size:clamp(1.9rem,4vw,3rem);letter-spacing:.04em;text-transform:uppercase;line-height:1;transition:color .3s}
.style-row p{color:var(--muted)}
.style-row:hover{padding-left:16px;background:linear-gradient(90deg,rgba(255,31,31,.1),transparent)}
.style-row:hover h3{color:var(--red)}
.home-styles .style-row{grid-template-columns:42px minmax(0,1.1fr) minmax(0,1fr);gap:18px;}
.style-index{font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;color:var(--red)}
.home-styles .style-row h3{font-size:clamp(1.55rem,3vw,2.45rem)}
.home-styles .style-row p{max-width:42ch}
.flow{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}
.step{position:relative;padding-top:24px;border-top:2px solid var(--line)}
.step::before{content:"";position:absolute;left:0;top:-6px;width:10px;height:10px;background:var(--red)}
.step b{display:block;font-family:var(--display);font-weight:400;font-size:1.5rem;letter-spacing:.05em;text-transform:uppercase}
.step small{color:var(--muted);font-size:.86rem;display:block;line-height:1.4}

/* ---------- work grid ---------- */
.filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:34px}
.filters[hidden]{display:none}
.chip{padding:.7em 1.3em;border:1px solid var(--line);font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);transition:color .25s,border-color .25s,background .25s}
.chip:hover{color:#fff;border-color:#555}
.chip.active{background:var(--red);border-color:var(--red);color:#fff}
.notice{margin-bottom:34px;padding:16px 20px;border:1px dashed var(--red);background:rgba(255,31,31,.07);color:#e6e6e6;font-size:.95rem}
.notice b{color:var(--red)}
.grid{column-width:300px;column-gap:18px}
.card{
  position:relative;display:block;width:100%;margin:0 0 18px;padding:0;text-align:left;
  break-inside:avoid;-webkit-column-break-inside:avoid;page-break-inside:avoid;
  background:#000;border:1px solid var(--line);overflow:hidden;
  transition:transform .4s var(--ease),border-color .3s,box-shadow .4s;
}
.card[hidden]{display:none!important}
.card:hover,.card:focus-visible{transform:translateY(-5px);border-color:var(--red);box-shadow:0 22px 50px -20px var(--red-glow)}
.card .media{position:relative;display:block;aspect-ratio:var(--ratio,16/9);background:linear-gradient(135deg,#240000,#050505)}
.card video,.card .media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.card .media.empty::after{
  content:"VIDEO FILE NOT FOUND - check the path in js/data.js";position:absolute;inset:0;display:grid;place-items:center;padding:20px;text-align:center;
  font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;color:var(--muted);
}
.card .shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,rgba(0,0,0,.88) 0%,rgba(0,0,0,0) 55%)}
.card .meta{position:absolute;left:0;right:0;bottom:0;padding:16px 16px 14px;display:block}
.card .tag{display:block;margin-bottom:2px;font-family:var(--mono);font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;color:var(--red)}
.card .title{display:block;font-family:var(--display);font-size:1.5rem;letter-spacing:.04em;line-height:1.05;text-transform:uppercase;color:#fff}
.card .play{
  position:absolute;right:14px;top:14px;width:40px;height:40px;border-radius:50%;
  background:rgba(0,0,0,.65);border:1px solid rgba(255,255,255,.35);
  opacity:0;transform:scale(.8);transition:opacity .3s,transform .3s var(--ease),background .3s;
}
.card .play::after{content:"";position:absolute;left:15px;top:11px;border-left:13px solid #fff;border-top:9px solid transparent;border-bottom:9px solid transparent}
.card:hover .play,.card:focus-visible .play{opacity:1;transform:none;background:var(--red);border-color:var(--red)}
@media (hover:none){.card .play{opacity:1;transform:none}}
.empty-msg{color:var(--muted);font-family:var(--mono);padding:30px 0}

/* video modal */
.modal{position:fixed;inset:0;z-index:300;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.93);animation:pagein .25s ease both}
.modal[hidden]{display:none}
.modal-close{position:absolute;right:16px;top:12px;width:48px;height:48px;font-size:2.2rem;line-height:1;color:#fff;border:1px solid var(--line);background:rgba(0,0,0,.6);transition:background .2s,border-color .2s;z-index:2}
.modal-close:hover{background:var(--red);border-color:var(--red)}
.modal-box{max-width:100%;max-height:100%;display:flex;flex-direction:column;gap:14px}
.modal-stage{--r:1.7778;width:min(92vw,calc(78vh * var(--r)),1200px);aspect-ratio:var(--r);background:#000;border:1px solid var(--line);box-shadow:0 30px 80px -30px var(--red-glow)}
.modal-stage video,.modal-stage iframe{width:100%;height:100%;border:0;background:#000}
.modal-info{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 18px;width:min(92vw,calc(78vh * var(--r,1.7778)),1200px)}
.modal-info h3{font-family:var(--display);font-weight:400;font-size:1.8rem;letter-spacing:.04em;text-transform:uppercase}
.modal-info .tag{font-family:var(--mono);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--red)}
.modal-info p{flex-basis:100%;color:var(--muted);font-size:.95rem}
.modal-info a{color:var(--red);border-bottom:1px solid var(--red)}

/* ---------- contact ---------- */
.contact-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(28px,5vw,72px);align-items:start}
.mail-box{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;margin:26px 0 22px;background:var(--card);border:1px solid var(--line)}
.mail-box a{font-family:var(--mono);font-size:.95rem;word-break:break-all;transition:color .2s}
.mail-box a:hover{color:var(--red)}
.copy{flex:none;padding:.55em 1em;border:1px solid var(--red);font-family:var(--mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--red);transition:background .2s,color .2s}
.copy:hover{background:var(--red);color:#fff}
.socials{display:flex;flex-wrap:wrap;gap:10px}
.socials a{padding:.65em 1.2em;border:1px solid var(--line);font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#d6d6d6;transition:border-color .25s,color .25s,transform .3s var(--ease)}
.socials a:hover{border-color:var(--red);color:var(--red);transform:translateY(-3px)}
.form{display:grid;gap:18px;padding:clamp(20px,3vw,38px);background:var(--card);border:1px solid var(--line);position:relative}
.form::before{content:"";position:absolute;left:-1px;top:-1px;width:44px;height:44px;border-left:3px solid var(--red);border-top:3px solid var(--red)}
.form h2{font-size:2.4rem}
.field{display:grid;gap:8px}
.field label{font-family:var(--mono);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.field input,.field textarea{width:100%;padding:14px 16px;background:#080808;border:1px solid var(--line);color:#fff;font:inherit;border-radius:0;transition:border-color .25s,box-shadow .25s}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(255,31,31,.18)}
.field textarea{min-height:160px;resize:vertical}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0;overflow:hidden}
.status{min-height:1.5em;font-size:.92rem;color:var(--muted)}
.status.ok{color:#62e58a}
.status.err{color:#ff7a7a}
.fineprint{color:var(--muted);font-size:.82rem}

/* ---------- footer ---------- */
.site-footer{border-top:1px solid var(--line);background:var(--bg-2);padding:46px 0 34px}
.foot{display:flex;justify-content:space-between;align-items:center;gap:22px;flex-wrap:wrap}
.foot .brand{font-size:2rem}
.foot nav{display:flex;flex-wrap:wrap;gap:18px}
.foot nav a{font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);transition:color .2s}
.foot nav a:hover{color:var(--red)}
.copyright{margin-top:26px;padding-top:22px;border-top:1px solid var(--line);color:var(--muted);font-family:var(--mono);font-size:.72rem;letter-spacing:.08em}

/* ---------- reveal on scroll ---------- */
.js .reveal{
  opacity:0;transform:translateY(26px);
  transition:opacity .8s var(--ease),transform .8s var(--ease);transition-delay:var(--d,0ms);
  animation:revealsafe .01s 3s forwards;
}
.js .reveal.in{opacity:1;transform:none}
@keyframes revealsafe{to{opacity:1;transform:none}}

/* ---------- custom cursor (desktop only) ---------- */
.cursor-dot,.cursor-ring{position:fixed;left:0;top:0;z-index:500;pointer-events:none;border-radius:50%;opacity:0;transition:opacity .3s}
.cursor-dot{width:6px;height:6px;margin:-3px 0 0 -3px;background:var(--red);transition:opacity .3s,background-color .2s ease,box-shadow .2s ease}
html.cursor-on-red .cursor-dot{background:#000;box-shadow:0 0 0 1px rgba(255,255,255,.96),0 0 4px rgba(255,255,255,.72)}
.cursor-ring{width:38px;height:38px;margin:-19px 0 0 -19px;border:1px solid rgba(255,31,31,.75);transition:opacity .3s,width .25s,height .25s,margin .25s,background .25s}
.cursor-ring.big{width:68px;height:68px;margin:-34px 0 0 -34px;background:rgba(255,31,31,.12)}
html.has-cursor .cursor-dot,html.has-cursor .cursor-ring{opacity:1}
html.has-cursor,html.has-cursor a,html.has-cursor button{cursor:none}
html.has-cursor input,html.has-cursor textarea{cursor:text}

/* ---------- responsive ---------- */
@media (max-width:980px){
  .hero-main-layout{grid-template-columns:1fr;gap:36px}
  .hero-left-col{order:1}
  .hero-photo-stage{order:2;min-height:280px}
  .about-grid,.contact-grid{grid-template-columns:1fr}
  .frame{max-width:420px}
  .flow{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:34px}
}
@media (max-width:860px){
  .burger{display:flex}
  .nav{
    position:fixed;inset:0;z-index:2;flex-direction:column;align-items:center;justify-content:center;gap:26px;
    background:rgba(7,7,7,.97);opacity:0;pointer-events:none;transform:translateY(-12px);
    transition:opacity .3s,transform .4s var(--ease);
  }
  html.nav-open .nav{opacity:1;pointer-events:auto;transform:none}
  .nav a{font-size:1.1rem}
  html.nav-open .nav a{animation:navSceneIn .24s var(--ease) both}
  html.nav-open .nav a:nth-child(2){animation-delay:25ms}
  html.nav-open .nav a:nth-child(3){animation-delay:50ms}
  html.nav-open .nav a:nth-child(4){animation-delay:75ms}
  html.nav-open .nav a:nth-child(5){animation-delay:100ms}
  html.nav-open .nav a:nth-child(6){animation-delay:125ms}
  .ambient-apps{display:none}
}
@keyframes navSceneIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@media (max-width:640px){
  .hero{min-height:100svh;padding:84px 0 32px}
  .hero-main-layout{gap:22px}
  .hero-left-col{gap:10px}
  .hero-toolbar{padding:4px 3px;gap:3px;margin-top:2px}
  .toolbar-app{width:21px;height:21px;font-size:.6rem}
  .toolbar-divider{width:14px;margin:2px 0}
  .tool-button{width:25px;height:25px}
  .tool-button svg{width:13px;height:13px}
  .hero::after{width:70vw;height:70vw;right:-14%;top:14%}
  .hero-title{font-size:clamp(2.8rem,13vw,4.8rem);gap:.1em;line-height:.96;margin-bottom:12px}
  .hero-title .glitch,.hero-title .outline{font-size:1em;letter-spacing:inherit;transform:none;-webkit-text-stroke-width:1px}
  .hero-role{font-size:clamp(1.15rem,4.5vw,1.45rem);letter-spacing:.14em;margin-bottom:12px;min-height:1.4em}
  .role-type-slot{width:clamp(190px,55vw,250px);min-width:clamp(190px,55vw,250px)}
  .hero-lede{max-width:38ch;margin-bottom:18px;font-size:.95rem;line-height:1.5}
  .hero-cta{gap:10px}
  .hero-photo-stage{min-height:220px}
  .timeline{margin-top:4px}
  .tl-inner{padding:5px 6px 4px}
  .tl-channel{flex-basis:16px;font-size:.45rem}
  .tl-ruler{padding-left:20px;font-size:.42rem;height:14px}
  .tl-composition{right:6px;top:-17px;font-size:.42rem}
  .tl-composition .app-badge{width:14px;height:14px;font-size:.5rem}
  .tl-track{height:11px;gap:2px}
  .tl-track i{height:10px}
  .tl-lane{height:16px}
  .tl-track.tl-graphics-track i{height:8px}
  .playhead{top:16px;bottom:3px;left:20px}
  .marquee{padding:16px 0}
  .marquee-track span{padding-right:30px}
  .marquee-track span::after{margin-left:30px}
  .home-services{grid-template-columns:1fr;gap:12px}
  .home-services .home-service{min-height:190px}
  .home-styles .style-row{grid-template-columns:30px minmax(0,1fr);gap:8px 14px}
  .home-styles .style-row p{grid-column:2}
  .style-row{grid-template-columns:1fr;gap:8px}
  .flow{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid{column-width:240px}
  .cta-band .wrap{flex-direction:column;align-items:flex-start}
}

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  ::view-transition-old(root),::view-transition-new(root){animation:none!important}
  .marquee-track{animation:none!important}
  .js .reveal{opacity:1;transform:none}
  .ambient-path,.ambient-path path,.ambient-speed-ramp,.path-node,.hero::after,.edit-term,.audio-bar,.track-box::before,.portrait-rimlight{animation:none!important}
  .ambient-graph path,.ambient-graph circle,.ambient-key,.ambient-wave,.tw-cursor{animation:none!important;opacity:1!important;transform:none!important;filter:none!important}
  .edit-term{display:none;filter:none;transform:none}
  .edit-term.term-cut,.edit-term.term-export{display:block;opacity:.3}
  .tool-button::after{display:none}
  .playhead{animation:none!important;left:45%!important}
}
@media (max-width:360px){
  .hero-title{font-size:clamp(2.6rem,12vw,3.2rem);gap:.1em}
  .hero-role{font-size:.95rem;letter-spacing:.08em}
  .role-type-slot{width:175px;min-width:175px}
}

/* ---------- homepage timeline + portrait refinement ---------- */
.hero-photo-stage{position:relative;height:clamp(420px,43vw,610px);min-height:0;overflow:visible;align-self:stretch}
.hero-photo-stage .photo-ambient-glow{width:min(470px,110%);height:min(470px,110%);filter:blur(44px);background:radial-gradient(ellipse,rgba(255,31,31,.28),rgba(184,0,0,.09) 48%,transparent 72%)}
#hero-photo-container{position:relative;z-index:1;width:min(100%,500px);max-width:none;height:100%;align-items:flex-end}
.hero-portrait{width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 16px 32px rgba(0,0,0,.48)) drop-shadow(0 0 22px rgba(255,31,31,.15))}
.edit-timeline{position:relative;z-index:2;margin-top:clamp(10px,2vw,24px);border:1px solid rgba(255,255,255,.11);border-bottom-color:rgba(255,31,31,.34);border-radius:7px;background:linear-gradient(180deg,rgba(18,18,20,.96),rgba(8,8,10,.96));box-shadow:0 18px 42px rgba(0,0,0,.4),inset 0 1px rgba(255,255,255,.035);overflow:hidden;color:#c9c9ce;font-family:var(--mono)}
.edit-timeline-head{min-height:38px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 15px;border-bottom:1px solid rgba(255,255,255,.09);background:linear-gradient(90deg,rgba(255,255,255,.035),transparent 50%)}
.timeline-sequence,.timeline-format{display:flex;align-items:center;gap:10px;font-size:.57rem;letter-spacing:.12em}
.timeline-sequence span{color:var(--red);font-weight:600}
.timeline-sequence b{color:#e9e9ec;font-weight:500}
.timeline-format{color:#87878f;font-size:.52rem;letter-spacing:.08em}
.timeline-format i{width:1px;height:10px;background:#414147}
.timeline-scroll{overflow-x:auto;scrollbar-color:#3c2527 #101012;scrollbar-width:thin}
.timeline-board{position:relative;min-width:810px}
.timeline-ruler,.timeline-lane{display:grid;grid-template-columns:76px minmax(0,1fr)}
.timeline-ruler{height:29px;border-bottom:1px solid rgba(255,255,255,.1)}
.timeline-label{position:relative;z-index:1;display:flex;align-items:center;gap:7px;padding:0 10px;border-right:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.018);color:#777780;font-size:.48rem;letter-spacing:.08em}
.timeline-ruler-label{color:#888891}
.timeline-ruler-track{display:flex;align-items:center;justify-content:space-between;padding:0 7px;background:repeating-linear-gradient(90deg,transparent 0 calc(16.666% - 1px),rgba(255,255,255,.11) calc(16.666% - 1px) 16.666%);font-size:.49rem;letter-spacing:.045em;color:#898991}
.timeline-lane{height:41px;border-bottom:1px solid rgba(255,255,255,.065)}
.timeline-lane:last-of-type{border-bottom:0}
.timeline-label b{color:#e0e0e4;font-size:.62rem;font-weight:600;letter-spacing:.08em}
.timeline-label span{font-size:.43rem;letter-spacing:.06em;color:#777780}
.timeline-track{position:relative;overflow:hidden;background:repeating-linear-gradient(90deg,transparent 0 calc(8.333% - 1px),rgba(255,255,255,.055) calc(8.333% - 1px) 8.333%)}
.timeline-clip{position:absolute;display:block;overflow:hidden;border-radius:3px}
.video-clip{top:4px;height:32px;border:1px solid rgba(180,185,195,.35);background:#20232a;box-shadow:inset 0 0 14px rgba(0,0,0,.45)}
.video-clip video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72;filter:saturate(.68) contrast(1.08)}
.video-clip::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,9,12,.2),transparent 35%,rgba(8,9,12,.15))}
.video-clip span,.fx-clip span,.audio-clip span{position:absolute;z-index:1;left:7px;bottom:3px;color:rgba(255,255,255,.7);font-size:.43rem;letter-spacing:.07em;text-shadow:0 1px 4px #000}
.video-clip-a{left:1%;width:23%}.video-clip-b{left:27%;width:25%}.video-clip-c{left:57%;width:22%}
.overlay-clip{height:24px;top:8px;border:1px solid rgba(174,123,206,.42);background:linear-gradient(100deg,rgba(78,43,96,.7),rgba(115,57,117,.48));box-shadow:inset 0 0 14px rgba(207,116,211,.08)}
.overlay-clip::before,.overlay-clip::after{content:"";position:absolute;top:50%;width:6px;height:6px;border:1px solid #d3b1d9;transform:translateY(-50%) rotate(45deg)}
.overlay-clip::before{left:25%}.overlay-clip::after{right:22%}
.overlay-clip i{position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(235,198,242,.28)}
.overlay-clip span{position:absolute;left:7px;bottom:2px;color:rgba(255,255,255,.68);font-size:.41rem;letter-spacing:.07em}
.overlay-clip-a{left:2%;width:37%}.overlay-clip-b{left:44%;width:24%}.overlay-clip-c{left:73%;width:20%}
.audio-clip{left:1%;right:2%;top:5px;height:30px;display:flex;align-items:center;border:1px solid rgba(221,55,58,.28);background:linear-gradient(180deg,rgba(111,25,28,.32),rgba(61,13,16,.28));color:#e24a4d}
.audio-clip svg{width:100%;height:22px;opacity:.88}
.audio-clip span{left:8px;bottom:1px;font-size:.39rem;color:rgba(255,225,225,.68)}
.fx-clip{top:8px;height:24px;border:1px solid rgba(188,155,111,.3);background:linear-gradient(90deg,rgba(109,76,48,.25),rgba(150,107,65,.36))}
.fx-clip i{position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 7px,rgba(245,194,130,.1) 7px 8px)}
.fx-clip-a{left:6%;width:24%}.fx-clip-b{left:40%;width:20%}.fx-clip-c{left:67%;width:25%}
.timeline-playhead{position:absolute;z-index:3;left:calc(76px + (100% - 76px) * .445);top:28px;bottom:0;width:1px;background:#ff3438;box-shadow:0 0 9px rgba(255,31,31,.72);pointer-events:none}
.timeline-playhead::before{content:"";position:absolute;top:0;left:-6px;width:12px;height:12px;border-radius:2px 2px 5px 5px;background:#ff3438;clip-path:polygon(0 0,100% 0,100% 70%,50% 100%,0 70%)}
.timeline-playhead span{position:absolute;top:-23px;left:0;transform:translateX(-50%);padding:3px 6px;border-radius:2px;background:#c81e24;color:#fff;font:600 .49rem/1 var(--mono);white-space:nowrap;letter-spacing:.04em}
@media(max-width:980px){.hero-photo-stage{height:clamp(340px,54vw,520px)}}
@media(max-width:640px){.hero-photo-stage{height:clamp(300px,88vw,390px)}.timeline-board{min-width:740px}.edit-timeline-head{padding:0 10px}.timeline-format{gap:6px;font-size:.47rem}.timeline-sequence{font-size:.52rem}}
@media(max-width:420px){.timeline-format span:first-child,.timeline-format i:first-of-type{display:none}}
/* ---------- requested hero refinements ---------- */
/* Larger editing toolbar, balanced against the title column. */
.hero-left-col{align-items:center;gap:clamp(16px,2.2vw,28px)}
.hero-toolbar{width:68px;min-width:68px;padding:12px 8px;gap:9px;border-radius:10px;margin-top:0}
.toolbar-apps{gap:7px}
.toolbar-app{width:30px;height:30px;font-size:.76rem}
.toolbar-divider{width:30px;margin:3px 0}
.toolbar-tools{gap:6px}
.tool-button{width:42px;height:42px;border-radius:7px}
.tool-button svg{width:22px;height:22px;stroke-width:1.7}

/* Portrait lighting stays atmospheric and behind the subject, without a card frame. */
.hero-photo-stage{isolation:isolate}
.hero-photo-stage .photo-ambient-glow{z-index:0;width:min(500px,112%);height:min(500px,108%);filter:blur(52px);opacity:.86;background:radial-gradient(ellipse at 53% 55%,rgba(157,18,27,.25),rgba(107,10,17,.12) 42%,transparent 72%)}
.hero-photo-stage::after{content:"";position:absolute;z-index:0;top:8%;right:3%;width:78%;height:76%;border:1px solid rgba(255,72,76,.12);border-left-color:transparent;border-bottom-color:rgba(255,72,76,.035);border-radius:50%;transform:rotate(-13deg);filter:drop-shadow(0 0 12px rgba(255,31,31,.14));pointer-events:none}
#hero-photo-container{z-index:1}
.hero-portrait{filter:drop-shadow(0 18px 34px rgba(0,0,0,.56)) drop-shadow(0 0 16px rgba(255,42,48,.16)) drop-shadow(0 0 34px rgba(114,9,18,.13))}

/* The playhead traverses the complete usable track area, then fades at the loop. */
.edit-timeline{width:100%;max-width:100%}
.timeline-scroll{width:100%}
.timeline-board{width:100%}
.timeline-playhead{left:76px;animation:timeline-playhead-travel 14s linear infinite;will-change:left,opacity}
@keyframes timeline-playhead-travel{
  0%{left:76px;opacity:0}
  2%{opacity:1}
  98%{left:calc(100% - 2px);opacity:1}
  100%{left:calc(100% - 2px);opacity:0}
}

/* Keep the enlarged controls legible while preserving clearance for the heading. */
@media(max-width:640px){
  .hero-left-col{align-items:flex-start;gap:10px}
  .hero-toolbar{width:52px;min-width:52px;padding:8px 5px;gap:5px;border-radius:8px}
  .toolbar-apps{gap:5px}
  .toolbar-app{width:25px;height:25px;font-size:.64rem}
  .toolbar-divider{width:24px;margin:2px 0}
  .toolbar-tools{gap:4px}
  .tool-button{width:36px;height:36px;border-radius:6px}
  .tool-button svg{width:19px;height:19px}
}
@media(max-width:380px){
  .hero-toolbar{width:48px;min-width:48px;padding-inline:4px}
  .tool-button{width:34px;height:34px}
  .tool-button svg{width:18px;height:18px}
  .hero-left-col{gap:8px}
}
/* Align the editing dock with the hero title while retaining its established size and hover states. */
.hero-left-col{align-items:flex-start}
.hero-toolbar{align-self:flex-start;margin-top:clamp(28px,3vw,38px)}
@media(max-width:640px){.hero-left-col{align-items:flex-start}.hero-toolbar{margin-top:30px}}
@media(max-width:380px){.hero-toolbar{margin-top:28px}}
/* Subtler photographic integration for the existing fp-cutout.png portrait. */
.hero-photo-stage .photo-ambient-glow{
  width:min(500px,112%);
  height:min(500px,108%);
  filter:blur(58px);
  opacity:.68;
  background:radial-gradient(ellipse at 52% 58%,rgba(123,14,23,.2),rgba(68,8,14,.13) 46%,transparent 74%)
}
.hero-photo-stage::after{
  top:10%;
  right:4%;
  width:76%;
  height:74%;
  border-color:rgba(255,68,72,.075);
  border-left-color:transparent;
  border-bottom-color:rgba(255,68,72,.025);
  filter:blur(.3px) drop-shadow(0 0 10px rgba(255,31,31,.1))
}
#hero-photo-container{width:min(100%,520px)}
.hero-portrait{
  filter:brightness(.88) contrast(.93) saturate(.9)
    drop-shadow(0 20px 38px rgba(0,0,0,.58))
    drop-shadow(0 0 2px rgba(30,7,10,.48))
    drop-shadow(0 0 12px rgba(255,38,42,.12))
    drop-shadow(0 0 30px rgba(113,8,18,.14))
}

/* ===== FINAL HOME HERO BALANCE ===== */

/* Left side: toolbar and content */
.hero-left-col {
  align-items: stretch;
  gap: clamp(18px, 2vw, 28px);
}

.hero-toolbar {
  align-self: stretch;
  margin-top: 0;
  justify-content: center;
  min-height: 100%;
}

/* Slightly larger title and supporting content */
.hero-title {
  font-size: clamp(2.6rem, 9vw, 8.25rem);
  margin-bottom: 20px;
}

.hero-role {
  font-size: clamp(1.5rem, 2.7vw, 2.35rem);
  margin-bottom: 20px;
}

.hero-lede {
  font-size: clamp(1rem, 1.45vw, 1.16rem);
  max-width: 52ch;
  margin-bottom: 26px;
}

.hero-cta {
  gap: 16px;
}

/* Right side: cinematic portrait frame */
.hero-photo-stage {
  display: flex;
  align-items: center;
  justify-content: center;
}

#hero-photo-container {
  isolation: isolate;
  border: 1px solid rgba(255, 65, 70, .2);
  border-radius: 5px;
  background:
    radial-gradient(
      ellipse at 50% 55%,
      rgba(115, 15, 22, .22),
      rgba(15, 8, 10, .7) 68%,
      rgba(7, 7, 7, .92)
    );
  box-shadow:
    0 20px 55px rgba(0, 0, 0, .38),
    inset 0 0 35px rgba(255, 31, 31, .045);
}

/* Subtle frame details */
#hero-photo-container::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(255, 255, 255, .09);
  pointer-events: none;
  z-index: 2;
}

#hero-photo-container::after {
  content: "ISH EDITION  /  VFX PORTRAIT";
  position: absolute;
  left: 18px;
  bottom: 12px;
  z-index: 3;
  font: 500 9px/1.4 var(--mono);
  letter-spacing: .16em;
  color: rgba(255, 255, 255, .48);
  pointer-events: none;
}

.hero-portrait {
  position: relative;
  z-index: 1;
  filter:
    brightness(.94)
    contrast(1.02)
    saturate(.94)
    drop-shadow(0 16px 30px rgba(0, 0, 0, .5));
}

/* Responsive safety */
@media (max-width: 980px) {
  .hero-main-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, .8fr);
    gap: 20px;
  }
}

@media (max-width: 640px) {
  .hero-left-col {
    align-items: flex-start;
  }

  .hero-toolbar {
    align-self: flex-start;
    margin-top: 30px;
  }
}

/* ==========================================
   ISH EDITION - CINEMATIC HERO FINAL POLISH
   ========================================== */

/* Raise the complete portrait section */
.hero-photo-stage {
  position: relative;
  isolation: isolate;
  transform: translateY(-32px);
  overflow: visible;
}

/* Rich red and black cinematic lighting */
.hero-photo-stage .photo-ambient-glow {
  position: absolute;
  z-index: 0;
  width: 115%;
  height: 110%;
  opacity: 1;
  filter: blur(65px);
  background:
    radial-gradient(
      ellipse at 48% 48%,
      rgba(255, 20, 35, .30),
      rgba(125, 5, 18, .20) 38%,
      rgba(0, 0, 0, .65) 72%,
      transparent 100%
    );
}

/* Recording monitor frame */
#hero-photo-container {
  position: relative;
  z-index: 2;
  width: min(100%, 520px);
  overflow: hidden;
  isolation: isolate;
  border: 1px solid rgba(255, 45, 55, .55);
  border-radius: 4px;
  background:
    linear-gradient(145deg, #16090b, #080808 55%, #170608);
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, .035),
    0 0 25px rgba(255, 0, 25, .16),
    0 20px 55px rgba(0, 0, 0, .65),
    inset 0 0 35px rgba(255, 20, 30, .10);
  transform: translateY(-8px);
}

/* Inner monitor border */
#hero-photo-container::before {
  content: "";
  position: absolute;
  inset: 12px;
  z-index: 4;
  border: 1px solid rgba(255, 255, 255, .13);
  pointer-events: none;
  box-shadow: inset 0 0 18px rgba(255, 0, 0, .06);
}

/* Recording indicator */
#hero-photo-container::after {
  content: "● REC  00:00:24:08   |   4K  |  24 FPS";
  position: absolute;
  top: 22px;
  left: 24px;
  bottom: auto;
  z-index: 5;
  padding: 7px 10px;
  color: #fff;
  background: rgba(8, 8, 8, .76);
  border-left: 2px solid #ff252f;
  font: 600 9px/1.4 var(--mono);
  letter-spacing: .10em;
  text-shadow: 0 0 8px rgba(255, 30, 40, .55);
  pointer-events: none;
}

/* Natural subject lighting and depth */
.hero-portrait {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
  height: auto;
  filter:
    brightness(.96)
    contrast(1.08)
    saturate(.96)
    drop-shadow(0 18px 30px rgba(0, 0, 0, .65))
    drop-shadow(0 0 18px rgba(255, 25, 35, .18));
}

/* Left editing toolbar in foreground */
.hero-left-col {
  position: relative;
  align-items: center;
  gap: clamp(18px, 2.2vw, 30px);
}

.hero-toolbar {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  align-self: center;
  margin-top: -12px;
  border: 1px solid rgba(255, 45, 55, .32);
  background: linear-gradient(
    160deg,
    rgba(28, 10, 12, .96),
    rgba(5, 5, 5, .96)
  );
  box-shadow:
    0 0 18px rgba(255, 20, 30, .13),
    8px 12px 28px rgba(0, 0, 0, .45);
  backdrop-filter: blur(12px);
}

/* Soft red highlight on editing tools */
.tool-button.selected {
  box-shadow:
    0 0 12px rgba(255, 30, 40, .22),
    inset 0 0 10px rgba(255, 30, 40, .10);
}

/* Responsive adjustment */
@media (max-width: 980px) {
  .hero-photo-stage {
    transform: translateY(-18px);
  }

  .hero-toolbar {
    margin-top: 0;
  }
}

@media (max-width: 640px) {
  .hero-photo-stage {
    transform: translateY(-8px);
  }

  .hero-toolbar {
    margin-top: 0;
  }

  #hero-photo-container::after {
    top: 17px;
    left: 18px;
    font-size: 8px;
  }
}

/* ===== PORTRAIT SIZE + CINEMATIC GLITCH ===== */

/* Make portrait fill more of the frame */
#hero-photo-container {
  width: min(112%, 590px);
  max-width: none;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 40%,
      rgba(180, 12, 25, .30),
      rgba(10, 5, 7, .96) 75%);
}

/* Bigger image without distortion */
.hero-portrait {
  width: 100%;
  height: auto;
  transform: scale(1.10);
  transform-origin: center center;
  filter:
    brightness(1.02)
    contrast(1.10)
    saturate(1.08)
    drop-shadow(0 0 18px rgba(255, 20, 35, .22));
}

/* Red and black cinematic light */
.hero-photo-stage::before {
  content: "";
  position: absolute;
  z-index: 3;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(110deg,
      transparent 35%,
      rgba(255, 15, 30, .12) 65%,
      transparent 100%),
    radial-gradient(ellipse at 85% 55%,
      rgba(255, 0, 25, .18),
      transparent 55%);
  mix-blend-mode: screen;
}

/* Top-to-bottom digital glitch scan */
#hero-photo-container {
  --glitch-red: rgba(255, 20, 40, .75);
}

#hero-photo-container .hero-portrait {
  animation: portrait-glitch 5s infinite;
}

#hero-photo-container::marker {
  content: none;
}

/* Moving scan line */
.hero-photo-stage {
  --scan-position: -15%;
}

/* .hero-photo-stage::after {
  content: "";
  position: absolute;
  z-index: 6;
  left: 0;
  right: 0;
  top: var(--scan-position);
  height: 3px;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 20, 35, .95),
    rgba(255, 100, 110, .8),
    transparent
  );
  box-shadow:
    0 0 10px rgba(255, 0, 25, .8),
    0 0 25px rgba(255, 0, 25, .45);
  animation: glitch-scan 5s linear infinite;
} */

/* Small digital distortion bursts */
@keyframes portrait-glitch {
  0%, 72%, 76%, 100% {
    filter: brightness(1.02) contrast(1.10) saturate(1.08);
    transform: scale(1.10);
  }
  73% {
    filter: brightness(1.2) contrast(1.2) saturate(1.5)
      drop-shadow(4px 0 rgba(255, 0, 35, .65));
    transform: scale(1.10) translateX(3px);
  }
  74% {
    transform: scale(1.10) translateX(-3px);
  }
  75% {
    transform: scale(1.10);
  }
}

@keyframes glitch-scan {
  0% { top: -10%; opacity: 0; }
  8% { opacity: 1; }
  88% { opacity: .9; }
  100% { top: 110%; opacity: 0; }
}

/* Mobile sizing */
@media (max-width: 640px) {
  #hero-photo-container {
    width: 100%;
    max-width: 100%;
  }

  .hero-portrait {
    transform: scale(1.06);
  }

  .hero-photo-stage::after {
    animation-duration: 6s;
  }
}

@media (prefers-reduced-motion: reduce) {
  #hero-photo-container .hero-portrait,
  .hero-photo-stage::after {
    animation: none;
  }
}
/* ===== DARK CINEMATIC PORTRAIT + GLITCH ===== */

#hero-photo-container {
  overflow: hidden;
  background: #080608;
}

.hero-portrait {
  filter: brightness(0.78) contrast(1.18) saturate(0.85);
  animation: portrait-glitch 6s infinite;
}

/* Occasional RGB glitch */
@keyframes portrait-glitch {
  0%, 88%, 91%, 94%, 100% {
    transform: scale(1.08);
    filter: brightness(0.78) contrast(1.18) saturate(0.85);
  }

  89% {
    transform: scale(1.08) translateX(3px);
    filter: brightness(0.9) contrast(1.3)
      drop-shadow(3px 0 rgba(255, 0, 35, 0.8))
      drop-shadow(-3px 0 rgba(0, 180, 255, 0.5));
  }

  90% {
    transform: scale(1.08) translateX(-3px);
    filter: brightness(0.72) contrast(1.4)
      drop-shadow(-3px 0 rgba(255, 0, 35, 0.7));
  }

  93% {
    transform: scale(1.08) translateX(2px);
  }
}

@media (max-width: 640px) {
  .hero-portrait {
    transform: scale(1.05);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-portrait {
    animation: none;
  }
}
/* ===== ISH EDITION: CINEMATIC PORTRAIT ===== */

#hero-photo-container {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 80% 35%,
      rgba(150, 0, 15, 0.28), transparent 55%),
    linear-gradient(145deg, #160609, #050505 70%);
  border: 1px solid rgba(255, 35, 45, 0.35);
  box-shadow:
    0 0 18px rgba(255, 0, 25, 0.12),
    0 18px 55px rgba(0, 0, 0, 0.65);
}

/* Portrait lighting and glitch */
.hero-portrait {
  display: block;
  width: 100%;
  height: auto;
  transform: scale(1.08);
  filter: brightness(0.78) contrast(1.2) saturate(0.88);
  animation: cinematic-glitch 7s infinite;
}

/* Red and black cinematic light */
#hero-photo-container::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    linear-gradient(110deg,
      rgba(0, 0, 0, 0.38),
      transparent 42%,
      rgba(150, 0, 15, 0.20)),
    radial-gradient(ellipse at 90% 45%,
      rgba(255, 0, 25, 0.22), transparent 60%),
    linear-gradient(to top,
      rgba(0, 0, 0, 0.45), transparent 45%);
  animation: light-shift 6s ease-in-out infinite alternate;
}

/* Occasional glitch, not continuous shaking */
@keyframes cinematic-glitch {
  0%, 86%, 89%, 93%, 100% {
    transform: scale(1.08);
    filter: brightness(0.78) contrast(1.2) saturate(0.88);
  }

  87% {
    transform: scale(1.08) translateX(3px);
    filter: brightness(0.95) contrast(1.35)
      drop-shadow(4px 0 rgba(255, 0, 30, 0.8))
      drop-shadow(-3px 0 rgba(0, 160, 255, 0.4));
  }

  88% {
    transform: scale(1.08) translateX(-3px);
    filter: brightness(0.72) contrast(1.4)
      drop-shadow(-4px 0 rgba(255, 0, 30, 0.8));
  }

  92% {
    transform: scale(1.08) translateX(2px);
  }
}

@keyframes light-shift {
  from { opacity: 0.65; }
  to   { opacity: 1; }
}

/* Recording indicator */
#hero-photo-container::after {
  content: "● REC";
  position: absolute;
  z-index: 5;
  top: 14px;
  left: 14px;
  color: #ff303d;
  background: rgba(0, 0, 0, 0.72);
  border: 1px solid rgba(255, 40, 50, 0.35);
  border-radius: 4px;
  padding: 5px 9px;
  font: 600 10px/1.2 monospace;
  letter-spacing: 1.5px;
  animation: rec-blink 1.5s infinite;
}

@keyframes rec-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* Mobile */
@media (max-width: 640px) {
  .hero-portrait {
    transform: scale(1.05);
  }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  .hero-portrait,
  #hero-photo-container::before,
  #hero-photo-container::after {
    animation: none;
  }
}
/* ===== COMPACT CINEMATIC FRAME ===== */

#hero-photo-container {
  width: min(100%, 440px);
  max-width: 440px;
  margin-inline: auto;
  border: 1px solid rgba(255, 35, 45, 0.3);
  box-shadow:
    0 0 14px rgba(255, 0, 25, 0.12),
    0 15px 35px rgba(0, 0, 0, 0.6);
}

.hero-portrait {
  width: 100%;
  height: auto;
  transform: scale(1.06);
  animation: cinematic-glitch 5s infinite;
}

/* Glitch starts immediately */
@keyframes cinematic-glitch {
  0% {
    transform: scale(1.06) translateX(3px);
    filter: brightness(0.95) contrast(1.35)
      drop-shadow(4px 0 rgba(255, 0, 30, 0.8))
      drop-shadow(-3px 0 rgba(0, 160, 255, 0.4));
  }

  2% {
    transform: scale(1.06) translateX(-3px);
    filter: brightness(0.75) contrast(1.4)
      drop-shadow(-4px 0 rgba(255, 0, 30, 0.8));
  }

  4%, 75%, 100% {
    transform: scale(1.06);
    filter: brightness(0.78) contrast(1.2) saturate(0.88);
  }

  76% {
    transform: scale(1.06) translateX(-3px);
    filter: brightness(1) contrast(1.4)
      drop-shadow(-4px 0 rgba(255, 0, 30, 0.8));
  }

  78% {
    transform: scale(1.06) translateX(3px);
    filter: brightness(0.85) contrast(1.3)
      drop-shadow(3px 0 rgba(0, 160, 255, 0.5));
  }
}

@media (max-width: 640px) {
  #hero-photo-container {
    width: 100%;
    max-width: 360px;
  }
}
/* ===== EDITOR STYLE PORTRAIT FRAME ===== */

#hero-photo-container {
  position: relative;
  isolation: isolate;
  width: min(100%, 440px);
  max-width: 440px;
  height: 100%;
  align-items: flex-end;
  overflow: hidden;

  border: 1px solid rgba(255, 45, 55, .42);
  border-radius: 4px;

  background:
    radial-gradient(ellipse at 75% 35%,
      rgba(150, 0, 18, .25), transparent 55%),
    linear-gradient(145deg, #130609, #050505 75%);

  box-shadow:
    0 0 18px rgba(255, 0, 25, .16),
    0 20px 45px rgba(0, 0, 0, .6),
    inset 0 0 25px rgba(255, 0, 25, .07);
}

/* Red illuminated frame edges */
#hero-photo-container::before {
  content: "";
  position: absolute;
  inset: 9px;
  z-index: 3;
  pointer-events: none;
  border: 1px solid rgba(255, 70, 75, .2);
  clip-path: polygon(
    0 0, 22px 0, 22px 1px, 1px 1px,
    1px 22px, 0 22px,
    0 100%, 22px 100%, 22px calc(100% - 1px),
    1px calc(100% - 1px), 1px calc(100% - 22px)
  );
}

/* Small editor-style corner markers */
#hero-photo-container .frame-details {
  position: absolute;
  inset: 10px;
  z-index: 4;
  pointer-events: none;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

/* Portrait */
.hero-portrait {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  transform: scale(1.16);
  transform-origin: center bottom;

  filter:
    brightness(.82)
    contrast(1.12)
    saturate(.88)
    drop-shadow(0 18px 32px rgba(0, 0, 0, .6))
    drop-shadow(0 0 18px rgba(255, 20, 30, .18));

  animation: red-black-glitch 5s infinite;
}
/* Recording label */
#hero-photo-container::after {
  content: "ISH GUPTA";
  position: absolute;
  z-index: 5;
  top: 14px;
  left: 14px;

  padding: 6px 9px;
  color: #ff3945;
  background: rgba(5, 5, 5, 0.82);
  border-left: 2px solid #ff2636;

  font: 600 9px monospace;
  letter-spacing: 1.5px;

  animation: rec-blink 1.5s infinite;
}

@keyframes rec-blink {
  50% { opacity: 0.45; }
}

@media (max-width: 360px) {
  #hero-photo-container {
    width: min(88%, 340px);
  }
}
/* ===== FINAL PORTRAIT LOOK ===== */

#hero-photo-container {
  width: min(100%, 430px);
  max-width: 430px;
  margin-inline: auto;
  overflow: hidden;
  background: #080608;
  border: 1px solid rgba(255, 25, 40, 0.35);
  box-shadow: 0 0 22px rgba(255, 0, 25, 0.18);
}

.hero-portrait {
  width: 100%;
  height: auto;
  transform: scale(1.10);
  filter: brightness(0.78) contrast(1.2) saturate(0.85);
  animation: red-black-glitch 5s infinite;
}

@keyframes red-black-glitch {
  0%, 3%, 70%, 100% {
    transform: scale(1.10);
    filter: brightness(0.78) contrast(1.2) saturate(0.85);
  }

  1% {
    transform: scale(1.10) translateX(3px);
    filter: brightness(0.95) contrast(1.4)
      drop-shadow(4px 0 rgba(255, 0, 25, 0.9));
  }

  2% {
    transform: scale(1.10) translateX(-3px);
    filter: brightness(0.65) contrast(1.5)
      drop-shadow(-4px 0 rgba(180, 0, 15, 0.9));
  }

  72% {
    transform: scale(1.10) translateX(-2px);
    filter: brightness(0.9) contrast(1.4)
      drop-shadow(3px 0 rgba(255, 0, 25, 0.8));
  }

  74% {
    transform: scale(1.10);
  }
}

@media (max-width: 640px) {
  #hero-photo-container {
    width: min(96%, 370px);
  }
  .hero-portrait {
    transform: scale(1.06);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-portrait {
    animation: none;
  }
}
